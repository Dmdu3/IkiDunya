  - id: menu_cikis
    metin: "\xC7\u0131k\u0131\u015F"
  - id: menu_oyuna_don
    metin: "Oyuna d\xF6n"
  - id: menu_ana_menu
    metin: "Ana men\xFC"
  - id: menu_geri
