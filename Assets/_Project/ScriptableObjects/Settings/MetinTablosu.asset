  m_Script: {fileID: 11500000, guid: e6a94b5ebb6a92f4ba478cb2a999aed1, type: 3}
  m_Name: MetinTablosu
  m_EditorClassIdentifier: Assembly-CSharp::IkiDunya.Core.MetinTablosu
  satirlar:
  - id: kart_golgelik
    metin: "G\xF6lgelik"
  - id: kart_golgelik_aciklama
    metin: "Se\xE7ti\u011Fin b\xF6lgeye g\xF6lgelik kur. Kum bir bant serinler, kal\u0131c\u0131."
  - id: kart_temizlik
    metin: "Temizlik Kampanyas\u0131"
  - id: kart_temizlik_aciklama
    metin: "En kirli \xFC\xE7 b\xF6lgede \xE7\xF6p bir kademe azal\u0131r."
  - id: kart_kumul
    metin: "Kumul Onar\u0131m\u0131"
  - id: kart_kumul_aciklama
    metin: "Se\xE7ti\u011Fin b\xF6lgede kumulu onar; dalga \xE7izgisi denize \xE7ekilir."
  - id: kart_yuva_tasima
    metin: "Yuva Ta\u015F\u0131ma"
  - id: kart_yuva_tasima_aciklama
    metin: "Bir yuvay\u0131 g\xFCvenli ve serin bir yere ta\u015F\u0131."
  - id: kart_isik
    metin: "I\u015F\u0131k Yasa\u011F\u0131"
  - id: kart_isik_aciklama
    metin: "Otel ve yol \u0131\u015F\u0131klar\u0131 geceleri kapan\u0131r, kal\u0131c\u0131."
  - id: kart_arac
    metin: "Ara\xE7 Yasa\u011F\u0131"
  - id: kart_arac_aciklama
    metin: "Kumsala ara\xE7 girmez; tekerlek izleri kaybolur."
  - id: kart_sezlong
    metin: "\u015Eezlong D\xFCzenlemesi"
  - id: kart_sezlong_aciklama
    metin: "\u015Eezlonglar her ak\u015Fam toplan\u0131r; engeller yar\u0131ya iner."
  - id: kart_tilki_citi
    metin: "Tilki \xC7iti"
  - id: kart_tilki_citi_aciklama
    metin: "Kumsal\u0131n kenar\u0131na \xE7it; tilki daha seyrek gelir."
  - id: kart_ag_temizligi
    metin: "Hayalet A\u011F Temizli\u011Fi"
  - id: kart_ag_temizligi_aciklama
    metin: "Denizdeki sahipsiz a\u011Flar ve misinalar toplan\u0131r."
  - id: kart_gonullu_cagrisi
    metin: "G\xF6n\xFCll\xFC \xC7a\u011Fr\u0131s\u0131"
  - id: kart_gonullu_cagrisi_aciklama
    metin: "Gelecek hafta iki g\xF6n\xFCll\xFC daha gelir."
  - id: kart_saha_arastirmasi
    metin: "Saha Ara\u015Ft\u0131rmas\u0131"
  - id: kart_saha_arastirmasi_aciklama
    metin: "Hen\xFCz bulunmam\u0131\u015F bir kan\u0131t\u0131 ortaya \xE7\u0131kar\u0131r."
  - id: kart_temiz_enerji
    metin: Temiz Enerji
  - id: kart_temiz_enerji_aciklama
    metin: "Bug\xFCn bir \u015Fey de\u011Fi\u015Ftirmez. Y\u0131llar sonra fark yarat\u0131r."
  - id: kart_aydinlatma
    metin: "Kaplumba\u011Fa Dostu Ayd\u0131nlatma"
  - id: kart_aydinlatma_aciklama
    metin: "Se\xE7ilen b\xF6lgenin lambalar\u0131 k\u0131s\u0131k, k\u0131rm\u0131z\u0131
      \u0131\u015F\u0131kl\u0131ya de\u011Fi\u015Fir."
  - id: kart_gozcu_kulubesi
    metin: "G\xF6zc\xFC Kul\xFCbesi"
  - id: kart_gozcu_kulubesi_aciklama
    metin: "Se\xE7ilen b\xF6lgede her gece devriye var."
  - id: kart_kulucka
    metin: "Kulu\xE7kahane"
  - id: kart_kulucka_aciklama
    metin: "B\xFCt\xFCn yuvalar se\xE7ilen b\xF6lgeye ta\u015F\u0131n\u0131r ve kafeslenir.
      Hepsi tek yerde olur."
  - id: kart_plaj_tabela
    metin: "Plaj Tabelalar\u0131"
  - id: kart_plaj_tabela_aciklama
    metin: Bu gece kumsalda daha az insan olur.
  - id: kart_bagis
    metin: "Ba\u011F\u0131\u015F Kampanyas\u0131"
  - id: kart_bagis_aciklama
    metin: "Halk deste\u011Fi kadar ba\u011F\u0131\u015F toplan\u0131r; halk biraz
      yorulur."
  - id: kart_basin
    metin: "Bas\u0131n B\xFClteni"
  - id: kart_basin_aciklama
    metin: "Bulunan kan\u0131tlar halka anlat\u0131l\u0131r. Otel bundan ho\u015Flanmaz."
  - id: kart_lobi
    metin: Belediye Lobisi
  - id: kart_lobi_aciklama
    metin: "Belediyeyle g\xF6r\xFC\u015F\xFCl\xFCr, ili\u015Fki iyile\u015Fir."
  - id: kart_koruma_alani
    metin: "Koruma Alan\u0131"
  - id: kart_koruma_alani_aciklama
    metin: "Se\xE7ilen b\xF6lge korunur: \u015Fezlong, insan, \u0131\u015F\u0131k
      ve ara\xE7 kalkar, bir daha giremez."
  - id: kart_otel_ortakligi
    metin: "Otel Ortakl\u0131\u011F\u0131"
  - id: kart_otel_ortakligi_aciklama
    metin: "Otel \u0131\u015F\u0131klar\u0131n\u0131 k\u0131sar; kar\u015F\u0131l\u0131\u011F\u0131nda
      bir b\xF6lgeye \u015Fezlong koyar."
  - id: kart_kooperatif
    metin: "Bal\u0131k\xE7\u0131 Kooperatifi"
  - id: kart_kooperatif_aciklama
    metin: "Bal\u0131k\xE7\u0131larla a\u011F de\u011Fi\u015Fimine ortak olunur."
  - id: kart_kum_torbasi
    metin: "Kum Torbas\u0131 Seddi"
  - id: kart_kum_torbasi_aciklama
    metin: "Se\xE7ilen b\xF6lgede f\u0131rt\u0131na yuvalar\u0131 basmaz."
  - id: kart_tahliye
    metin: Yuva Tahliyesi
  - id: kart_tahliye_aciklama
    metin: "Dalga \xE7izgisinin alt\u0131ndaki b\xFCt\xFCn yuvalar g\xFCvenli yere
      ta\u015F\u0131n\u0131r."
  - id: kart_acil_sulama
    metin: Acil Sulama
  - id: kart_acil_sulama_aciklama
    metin: "B\xFCt\xFCn yuvalar bu tur ve bu gece serinletilir."
  - id: kart_dron
    metin: "Dron Taramas\u0131"
  - id: kart_dron_aciklama
    metin: "Haritadaki b\xFCt\xFCn kay\u0131p izleri incelenir, kan\u0131tlar\u0131
      a\xE7\u0131l\u0131r."
  - id: kart_universite
    metin: "\xDCniversite Ortakl\u0131\u011F\u0131"
  - id: kart_universite_aciklama
    metin: Bundan sonra her tur bir kart fazla gelir.
  - id: gorev_temizlik
    metin: Temizlik
  - id: gorev_temizlik_aciklama
    metin: "Bir b\xF6lgenin \xE7\xF6p\xFC bir kademe azal\u0131r."
  - id: gorev_devriye
    metin: Gece devriyesi
  - id: gorev_devriye_aciklama
    metin: "Bu gece o b\xF6lgede insan ve fener olmaz."
  - id: gorev_kafes
    metin: Yuva kafesi
  - id: gorev_kafes_aciklama
    metin: "Yuvaya tilki giremez, kal\u0131c\u0131."
  - id: gorev_golge
    metin: "G\xF6lge ve sulama"
  - id: gorev_golge_aciklama
    metin: "Yuvan\u0131n kumu bu tur ve gece serin kal\u0131r."
  - id: gorev_bilgilendirme
    metin: Bilgilendirme
  - id: gorev_bilgilendirme_aciklama
    metin: "Halk\u0131 bilgilendir; halk deste\u011Fi artar."
  - id: kanit_isi
    metin: "Kan\u0131t: Is\u0131"
  - id: kanit_isi_not
    metin: "Yavrular s\u0131cak kumda t\xFCkendi. G\xF6lge, kumu serinletir."
  - id: kanit_isik
    metin: "Kan\u0131t: I\u015F\u0131k"
  - id: kanit_isik_not
    metin: "Yavrular \u0131\u015F\u0131\u011Fa d\xF6nd\xFC, denizi kaybetti. I\u015F\u0131klar
      s\xF6nd\xFCr\xFClebilir."
  - id: kanit_cop
    metin: "Kan\u0131t: \xC7\xF6p"
  - id: kanit_cop_not
    metin: "Yavrular a\u011Fa, halkaya, tekerlek izine tak\u0131ld\u0131. Ara\xE7lar
      ve \u015Fezlonglar d\xFCzenlenebilir."
  - id: kanit_avci
    metin: "Kan\u0131t: Avc\u0131"
  - id: kanit_avci_not
    metin: "Bir tilki yuvay\u0131 ya da s\xFCr\xFCy\xFC buldu. \xC7it onu uzak tutar."
  - id: kanit_su
    metin: "Kan\u0131t: Su"
  - id: kanit_su_not
    metin: "Deniz yuvay\u0131 bast\u0131. Yuvalar ta\u015F\u0131nabilir."
  - id: olay_otel
    metin: "Otel kumsala yeni bir \u015Fezlong s\u0131ras\u0131 koymak istiyor."
  - id: olay_otel_a
    metin: "Kabul et (b\xFCt\xE7e artar)"
  - id: olay_otel_b
    metin: "Reddet (otel k\xFCser)"
  - id: olay_festival
    metin: "Belediye kumsalda bir gece festivali d\xFCzenlemek istiyor."
  - id: olay_festival_a
    metin: Kabul et (destek artar)
  - id: olay_festival_b
    metin: "Reddet (belediye k\xFCser)"
  - id: olay_balikci
    metin: "Bal\u0131k\xE7\u0131lar, a\u011Flar\u0131n\u0131 kaplumba\u011Fa dostu
      a\u011Flarla de\u011Fi\u015Ftirmek i\xE7in destek istiyor."
  - id: olay_balikci_a
    metin: "Destekle (b\xFCt\xE7e azal\u0131r)"
  - id: olay_balikci_b
    metin: "\u015Eimdi de\u011Fil"
  - id: olay_sicak_dalga
    metin: "Hava tahmini: gelecek haftan\u0131n sonunda s\u0131cak dalgas\u0131.
      Kum \u0131s\u0131nacak; haz\u0131rlanmak i\xE7in bir haftan var."
  - id: olay_firtina
    metin: "Hava tahmini: gelecek haftan\u0131n sonunda f\u0131rt\u0131na. Dalga
      \xE7izgisinin alt\u0131ndaki yuvalar su alabilir; haz\u0131rlanmak i\xE7in
      bir haftan var."
  - id: olay_okul
    metin: "Bir okul, kumsala ziyaret d\xFCzenlemek istiyor."
  - id: olay_okul_a
    metin: "Kabul et (bir g\xF6n\xFCll\xFC me\u015Fgul)"
  - id: olay_okul_b
    metin: Reddet
  - id: olay_tamam
    metin: Tamam
  - id: olay_otel_bar
    metin: "Otel kumsala bir bar a\xE7mak istiyor."
  - id: olay_otel_bar_a
    metin: Kabul et
  - id: olay_otel_bar_b
    metin: Reddet
  - id: olay_festival_cop
    metin: "Festivalden sonra kumsal \xE7\xF6p dolu."
  - id: olay_festival_cop_a
    metin: "G\xF6n\xFCll\xFCler temizlesin"
  - id: olay_festival_cop_b
    metin: "B\u0131rak"
  - id: olay_balikci_ag_getirdi
    metin: "Bal\u0131k\xE7\u0131lar denizden bir hayalet a\u011F \xE7\u0131kard\u0131."
  - id: olay_balikci_ag_getirdi_a
    metin: Sergile
  - id: olay_balikci_ag_getirdi_b
    metin: "Geri d\xF6n\xFC\u015F\xFCme sat"
  - id: olay_gazeteci
    metin: "Bir gazeteci kaybolan yuvalar\u0131 soruyor."
  - id: olay_gazeteci_a
    metin: "A\xE7\u0131k konu\u015F"
  - id: olay_gazeteci_b
    metin: Sessiz kal
  - id: olay_kopek
    metin: "Turistler kumsala k\xF6pek getiriyor."
  - id: olay_kopek_a
    metin: "Yasak tabelas\u0131 as"
  - id: olay_kopek_b
    metin: "\u0130zin ver"
  - id: olay_bagisci
    metin: "Bir ba\u011F\u0131\u015F\xE7\u0131, ad\u0131n\u0131n kumsala yaz\u0131lmas\u0131
      \u015Fart\u0131yla para veriyor."
  - id: olay_bagisci_a
    metin: Kabul et
  - id: olay_bagisci_b
    metin: Reddet
  - id: olay_universite
    metin: "\xDCniversite stajyer g\xF6ndermek istiyor."
  - id: olay_universite_a
    metin: Kabul et
  - id: olay_universite_b
    metin: Reddet
  - id: olay_otel_isik
    metin: "Otel inad\u0131na b\xFCt\xFCn \u0131\u015F\u0131klar\u0131n\u0131 a\xE7t\u0131."
  - id: olay_otel_isik_a
    metin: "\u015Eik\xE2yet et"
  - id: olay_otel_isik_b
    metin: Bekle
  - id: olay_belediye_kesinti
    metin: "Belediye \xF6dene\u011Fi kesmek istiyor."
  - id: olay_belediye_kesinti_a
    metin: "Toplant\u0131ya git"
  - id: olay_belediye_kesinti_b
    metin: Kabul et
  - id: olay_balikci_ag_atti
    metin: "Bal\u0131k\xE7\u0131lar eski a\u011Flar\u0131n\u0131 denize att\u0131."
  - id: olay_balikci_ag_atti_a
    metin: "Temizlik ekibi g\xF6nder"
  - id: olay_balikci_ag_atti_b
    metin: "B\u0131rak"
  - id: bolum1_giris
    metin: "D\xF6n\xFC\u015F. Do\u011Fdu\u011Fu kumsal onu \xE7a\u011F\u0131r\u0131yor."
  - id: bolum2_giris
    metin: "Yuva geceleri. Kumu iyi se\xE7."
  - id: bolum3_giris
    metin: "Bekleyi\u015F. Kumun alt\u0131nda yeni hayatlar b\xFCy\xFCyor."
  - id: bolum4_giris
    metin: "Ka\xE7\u0131\u015F. G\xFCn do\u011Fmadan denize."
  - id: bolum5_giris
    metin: "\u0130lk y\xFCz\xFC\u015F. U\xE7suz bucaks\u0131z mavi."
  - id: ipucu_poset
    metin: "Denizanas\u0131 kas\u0131larak y\xFCzer, po\u015Fet d\xFCz s\xFCz\xFCl\xFCr.
      Yak\u0131ndan bak, E ile ye."
  - id: ipucu_nefes
    metin: "Nefesin azal\u0131yor. Space'i bas\u0131l\u0131 tutup y\xFCzeye \xE7\u0131k;
      y\xFCzeyde teknelere dikkat et."
  - id: ipucu_poset_yuttu
    metin: "Po\u015Fet yuttun! Enerji kaybettin ve bir s\xFCre yava\u015Fs\u0131n.
      Denizanas\u0131 kas\u0131larak y\xFCzer, po\u015Fet d\xFCz s\xFCz\xFCl\xFCr."
  - id: ipucu_ag
    metin: "A\u011Fa tak\u0131ld\u0131n! E'ye art arda bas."
  - id: ipucu_dalga
    metin: "Dalga gelirken Space ile alt\u0131ndan dal."
  - id: ipucu_termal
    metin: "T: termal g\xF6r\xFCn\xFCm. Kumun s\u0131cakl\u0131\u011F\u0131n\u0131
      g\xF6r; \xE7ok s\u0131cak ya da \xE7ok serin yerden ka\xE7\u0131n."
  - id: ipucu_kazma
    metin: "Dur ve A ile D'ye s\u0131rayla basarak kaz. Yumurtlad\u0131ktan sonra
      ayn\u0131 \u015Fekilde \xF6rt."
  - id: ipucu_kumdan_cikis
    metin: "W ile yukar\u0131 kaz. Kum serinlemeden \xE7\u0131kma, ama \xE7ok da
      bekleme."
  - id: ipucu_suru
    metin: "\xD6nc\xFC sensin; s\xFCr\xFC seni izler. Shift ile da\u011F\u0131l,
      Space ile z\u0131pla."
  - id: ipucu_takili
    metin: "Bir yavru tak\u0131ld\u0131 ya da ters d\xF6nd\xFC. Yan\u0131na git,
      E'yi bas\u0131l\u0131 tut."
  - id: ipucu_tilki
    metin: "Tilki kumsal\u0131n kenar\u0131nda. \xD6n\xFCndeki g\xF6r\xFC\u015F alan\u0131ndan
      uzak dur, kumul g\xF6lgesinde ilerle."
  - id: ipucu_kanit
    metin: "Haritadaki renkli izlere t\u0131kla: her biri bir kan\u0131t."
  - id: ipucu_gonullu
    metin: "Bir g\xF6rev se\xE7, sonra haritada b\xF6lgeye ya da yuvaya t\u0131kla."
  - id: ipucu_kart
    metin: "B\xFCt\xE7en yetti\u011Fince kart oyna. B\xF6lge ya da yuva isteyen kartta
      haritaya t\u0131kla."
  - id: ipucu_poset_surusu
    metin: "Ak\u0131nt\u0131 bir s\xFCr\xFC ta\u015F\u0131yor. Denizanalar\u0131n\u0131
      ye, po\u015Fetlerden ka\xE7. Yeterince yiyince \xF6n\xFCndeki ak\u0131nt\u0131
      a\xE7\u0131l\u0131r."
  - id: ipucu_girdap
    metin: "Girdaba kap\u0131ld\u0131n! Halkan\u0131n bo\u015Flu\u011Funu yakala;
      parlak \u015Famand\u0131ralar yolu g\xF6sterir."
  - id: ipucu_cop_seli
    metin: "Ufukta k\xF6p\xFCk g\xF6r\xFCrsen dalga geliyor: kum tepesine \xE7\u0131k.
      Su \xE7ekilince denize ko\u015F."
  - id: bildirim_deneme_insan
    metin: "Bir insan seni g\xF6rd\xFC; anne \xFCrk\xFCp denize d\xF6nd\xFC. Kalan
      deneme: {0}"
  - id: bildirim_deneme_enerji
    metin: "Annenin g\xFCc\xFC t\xFCkendi; denize d\xF6nd\xFC. Kalan deneme: {0}"
  - id: bildirim_kendiliginden_yuva
    metin: "Anne daha fazla dayanamad\u0131 ve yuvas\u0131n\u0131 oldu\u011Fu yere
      kazd\u0131."
  - id: bildirim_deniz_enerji
    metin: "G\xFCc\xFCn t\xFCkendi. Son kontrol noktas\u0131ndan devam ediyorsun."
  - id: bildirim_deniz_yakalandi
    metin: "Bir avc\u0131 seni yakalad\u0131. Son kontrol noktas\u0131ndan devam
      ediyorsun."
  - id: bildirim_poset_enerji
    metin: "G\xFCc\xFCn t\xFCkendi; bu a\u015Fama ba\u015Ftan ba\u015Fl\u0131yor."
  - id: final_30_yil
    metin: "30 y\u0131l sonra"
  - id: final_kurtarilan
    metin: "Denize ula\u015Fan yavru"
  - id: jenerik
    metin: "\u0130K\u0130 D\xDCNYA, TEK YA\u015EAM\\n\\nBir \xF6\u011Frenci oyun
      projesi\\n\\nEkip\\nUmut \xB7 Toprak \xB7 Yusuf \xB7 Abd\xFC\\n\\nDeniz kaplumba\u011Falar\u0131
      her y\u0131l do\u011Fduklar\u0131 kumsala d\xF6ner.\\nO kumsal\u0131n nas\u0131l
      olaca\u011F\u0131 bizim elimizde.\\n\\nOynad\u0131\u011F\u0131n i\xE7in te\u015Fekk\xFCrler."
  - id: oyun_adi
    metin: "\u0130ki D\xFCnya, Tek Ya\u015Fam"
  - id: menu_yeni_oyun
    metin: Yeni oyun
  - id: menu_devam_et
    metin: Devam et
  - id: menu_parkurlar
